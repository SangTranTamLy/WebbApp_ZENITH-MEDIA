# Configure only the NEW Supabase project. Old connection values were removed.
# Legacy DATABASE_URL is never used by the store or database tools.
PORT=4000
SHOP_WEB_ORIGIN=http://127.0.0.1:5173
# Fill from the new project dashboard; HOST_CONFIRM must match the database host.
SHOP_DATABASE_URL=
SHOP_DATABASE_HOST_CONFIRM=
SHOP_SUPABASE_URL=
SHOP_SUPABASE_KEY=
SHOP_ADMIN_USER_ID=
SHOP_WORKER_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional, privileged: only for processing confirmed account-deletion requests.
SHOP_SUPABASE_SERVICE_ROLE_KEY=
SHOP_MB_ACCOUNT=
SHOP_MB_NAME=
SHOP_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
SHOP_R2_ACCESS_KEY=
SHOP_R2_SECRET_KEY=
SHOP_R2_PRODUCTS_BUCKET=zenith-products-private
SHOP_R2_PREVIEWS_BUCKET=zenith-previews
SHOP_PREVIEW_ORIGIN=https://PREVIEW_CDN_HOST
SHOP_RESEND_KEY=
SHOP_EMAIL_FROM=ZENITH MEDIA <orders@VERIFIED_SENDING_DOMAIN>
SHOP_DISCORD_ADMIN=
SHOP_DISCORD_COMMUNITY=
# Never enable SHOP_DEMO in production. Use pnpm demo locally.
