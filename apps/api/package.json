{
  "name": "@zenith/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "demo": "tsx watch src/demo-server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/apps/api/src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:inventory": "tsx src/db/inventory.ts",
    "db:seed": "tsx src/db/seed.ts",
    "workers:typecheck": "tsc -p tsconfig.workers.json --noEmit",
    "workers:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@zenith/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@supabase/supabase-js": "^2.112.3",
    "@electric-sql/pglite": "^0.3.14",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.1",
    "typescript": "~5.7.2",
    "wrangler": "^4.45.0"
  }
}
