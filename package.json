{
  "name": "zenith-store",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @zenith/web --filter @zenith/api dev",
    "demo": "pnpm --parallel --filter @zenith/web --filter @zenith/api demo",
    "build": "pnpm --filter @zenith/api build && pnpm --filter @zenith/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @zenith/api test && pnpm --filter @zenith/worker test",
    "test:e2e": "playwright test",
    "lint": "pnpm --filter @zenith/web lint",
    "db:migrate": "pnpm --filter @zenith/api db:migrate",
    "db:inventory": "pnpm --filter @zenith/api db:inventory",
    "worker": "pnpm --filter @zenith/worker start",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10"
  }
}
